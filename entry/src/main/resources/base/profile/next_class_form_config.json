      "src": "./ets/widget/pages/NextClassCard.ets",
      "uiSyntax": "arkts",
      "window": { "designWidth": 720, "autoDesignWidth": true },
      "colorMode": "auto",
      "isDynamic": true,
      "isDefault": false,
      "updateEnabled": true,
      "updateDuration": 1,
      "defaultDimension": "2*2",
      "supportDimensions": ["2*2", "2*4"]
    },
    {
      "name": "WeekTimetableCard",
      "displayName": "$string:week_timetable_name",
      "description": "$string:week_timetable_description",
      "src": "./ets/widget/pages/WeekTimetableCard.ets",
      "uiSyntax": "arkts",
      "window": { "designWidth": 720, "autoDesignWidth": true },
      "colorMode": "auto",
      "isDynamic": true,
      "isDefault": false,
      "updateEnabled": true,
